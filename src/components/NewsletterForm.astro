---
/**
 * Nieuwsbrief, via SuperHoreca.
 *
 * Vroeger was dit een Netlify-formulier. De site draait op Vercel, en Vercel
 * aanvaardt geen POST op een statische pagina: inschrijven gaf "HTTP ERROR 405".
 * Nu bouwt het script van SuperHoreca het formulier zelf in dit vak. Het stuurt
 * naar de server van SuperHoreca, die een bevestigingsmail stuurt (dubbele
 * opt-in) en de lijst bijhoudt.
 *
 * Zonder JavaScript is er een gewone link naar de inschrijfpagina.
 */
import { route, strings, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const T = strings(lang);

const EMBED = 'https://superhoreca.app/embed/omgekeerde-wereld-bv/newsletter';
const PAGE = 'https://superhoreca.app/newsletter/omgekeerde-wereld-bv';
---

<div class:list={['newsletter', compact && 'newsletter--compact']}>
  <div id="nieuwsbrief-vak" class="newsletter__vak"></div>
  <noscript>
    <a class="btn btn--primary" href={PAGE}>{T.newsletterCta}</a>
  </noscript>
  <p class="newsletter__privacy">
    <a href={route('privacy', lang)}>{T.privacyPolicy}</a>
  </p>
</div>

<script
  is:inline
  async
  src={EMBED}
  data-auto-form
  data-mount="#nieuwsbrief-vak"
  data-lang={lang}
  data-theme="dark"
  data-color="#ffd23f"
  data-cta={T.newsletterCta}
></script>

<style>
  .newsletter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  /* Hun formulier is maximaal 380px; in de voettekst mag het de kolom vullen.
     De kleuren komen uit tokens.css, zodat het vak meekleurt met het dag- en
     nachtthema. Hun script zet die variabelen inline, vandaar !important. */
  .newsletter__vak :global(.ssn-form) {
    max-width: none;
    font-family: var(--font-body);
    --ssn-c: var(--accent) !important;
    --ssn-h: var(--accent-dim) !important;
    --ssn-ink: var(--accent-ink) !important;
    --ssn-ring: color-mix(in srgb, var(--accent) 25%, transparent) !important;
  }

  /* Hun donkere stijl zet witte tekst op een doorzichtig veld: onleesbaar op de
     lichte voettekst van het dagthema. */
  .newsletter__vak :global(.ssn-input) {
    background: var(--bg-inset);
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .newsletter__vak :global(.ssn-input::placeholder) {
    color: var(--ink-faint);
  }

  .newsletter__vak :global(.ssn-hint) {
    color: var(--ink-faint);
  }

  .newsletter__vak :global(.ssn-btn) {
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .newsletter__privacy {
    font-size: var(--step--2);
  }

  .newsletter__privacy a {
    color: var(--ink-faint);
  }
</style>
