---
/**
 * KAA Gent: officieel Buffalo Point. Eén component voor beide talen;
 * /kaa-gent/ en /en/kaa-gent/ zijn twee regels die hier binnenkomen.
 *
 * De matchen komen uit content/events.yaml (type: sport, met KAA Gent in de
 * titel). Is de merch er of komen de tickets: pas de tekst hieronder aan.
 */
import Base from '../layouts/Base.astro';
import InstaCarrousel from './InstaCarrousel.astro';
import MatchAftellen from './MatchAftellen.astro';

import { events } from '../lib/content';
import { buildAgenda } from '../lib/events';
import { euro, formatDate, formatTime } from '../lib/format';
import { route, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const en = lang === 'en';

const POST = 'https://www.instagram.com/p/DfMpj-ogB-M/';

const breadcrumbs = [
  { name: 'Home', url: route('home', lang) },
  { name: 'KAA Gent', url: route('kaaGent', lang) },
];

const matches = buildAgenda(events, new Date()).upcoming.filter(
  (e) => e.type === 'sport' && e.title.includes('KAA Gent'),
);

// Een match met een eigen affiche: dat is een uitstap met het café.
const uitstap = matches.find((m) => m.image);

const punten = [
  {
    title: en ? 'Big screen' : 'Groot scherm',
    text: en
      ? 'Every Buffalo match live, home and away, with the sound on.'
      : 'Elke Buffalo-match live, thuis en uit, met geluid.',
  },
  {
    title: 'Merch',
    text: en ? 'Soon available at the bar.' : 'Binnenkort verkrijgbaar aan de toog.',
  },
  {
    title: 'Tickets',
    text: en
      ? 'Always together in block 321, next to the Spionkop. With a ticket voucher, see below.'
      : 'Altijd samen in vak 321, naast de Spionkop. Met een ticketvoucher, zie hieronder.',
  },
];

---

<Base
  title="KAA Gent"
  description={en
    ? 'De Omgekeerde Wereld is an official Buffalo Point of KAA Gent, the first in Ghent. Every match live on the big screen, home and away. See all the fixtures.'
    : 'De Omgekeerde Wereld is een officieel Buffalo Point van KAA Gent, het allereerste in Gent. Elke match live op groot scherm, thuis en uit. Bekijk alle matchen.'}
  lang={lang}
  active="kaaGent"
  image="/images/kaa-gent-pintje.jpg"
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="wrap wrap--wide">
      <p class="eyebrow">{en ? 'Official Buffalo Point' : 'Officieel Buffalo Point'}</p>
      <h1>{en ? 'KAA Gent at den Omgekeerde' : 'KAA Gent in den Omgekeerde'}</h1>

      <div class="kop">
        <p class="lead">
          {
            en
              ? 'We are an official Buffalo Point of KAA Gent, the very first in Ghent. Home or away: this is where we support together. Allez AG!'
              : 'We zijn een officieel Buffalo Point van KAA Gent, het allereerste in Gent. Thuis of uit: hier supporteren we samen. Allez AG!'
          }
        </p>
        <ul class="punten" role="list">
          {
            punten.map((p) => (
              <li>
                <strong>{p.title}</strong>
                {p.text}
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="voucher" aria-labelledby="voucher-titel">
        <p class="voucher__label">{en ? 'Available now' : 'Vanaf nu beschikbaar'}</p>
        <h2 class="voucher__titel" id="voucher-titel">
          {en ? 'KAA Gent ticket vouchers' : 'KAA Gent-ticketvouchers'}
          <span class="voucher__prijs">{euro(20)}</span>
        </h2>
        <p>
          {
            en
              ? 'Buy the voucher at the bar and redeem it on the KAA Gent ticket page, by the Wednesday before the home match at the latest. That is how you claim your seat in block 321.'
              : 'Koop de voucher aan de toog en wissel hem in op de ticketpagina van KAA Gent, ten laatste de woensdag voor de thuismatch. Zo claimt ge uw plaats in vak 321.'
          }
        </p>
        <p class="voucher__link">
          <a class="btn btn--primary" href="https://www.kaagent.be/nl/tickets" rel="noopener">
            {en ? 'To the KAA Gent ticket page' : 'Naar de ticketpagina van KAA Gent'}
          </a>
        </p>
      </aside>

      {
        uitstap && (
          <aside class="uitstap" aria-labelledby="uitstap-titel">
            <img
              class="uitstap__affiche"
              src={uitstap.image}
              alt={uitstap.imageAlt ?? ''}
              width="864"
              height="1080"
              loading="lazy"
              decoding="async"
            />
            <div class="uitstap__tekst">
              <p class="voucher__label">OW × Copain</p>
              <h2 class="uitstap__titel" id="uitstap-titel">
                {en ? 'Off to the AG with the café' : "Met 't café naar den AG"}
              </h2>
              <p class="uitstap__wanneer">
                {uitstap.title} · {formatDate(uitstap.start, lang)} · {formatTime(uitstap.start)}
              </p>
              <p>{en ? (uitstap.descriptionEn ?? uitstap.description) : uitstap.description}</p>
              {uitstap.link && (
                <p class="voucher__link">
                  <a class="btn btn--primary" href={uitstap.link} rel="noopener">
                    {en ? 'Get your ticket' : 'Koop uw ticket'}
                  </a>
                </p>
              )}
            </div>
          </aside>
        )
      }

      <InstaCarrousel lang={lang} reeks="kaa-gent" duur={30} />

      <p class="post">
        <a href={POST} rel="noopener">{en ? 'See the post on Instagram' : 'Bekijk de post op Instagram'} →</a>
      </p>
    </div>
  </section>

  <section class="section section--tight" id="matchen">
    <div class="wrap wrap--wide">
      <h2>{en ? 'The matches' : 'De matchen'}</h2>

      <MatchAftellen lang={lang} matches={matches} />

      {
        matches.length > 0 ? (
          <ol class="matchen" role="list">
            {matches.map((m) => {
              const thuis = m.title.startsWith('KAA Gent');
              const uur = m.provisional
                ? en
                  ? 'To be confirmed'
                  : 'Onder voorbehoud'
                : formatTime(m.start);
              return (
                <li class="match">
                  <span class="match__datum">
                    {formatDate(m.start, lang, m.start.slice(0, 4) !== String(new Date().getFullYear()))}
                  </span>
                  <span class:list={['match__uur', m.provisional && 'match__uur--open']}>{uur}</span>
                  <span class="match__titel">{m.title}</span>
                  <span class="match__plek">
                    {thuis ? (en ? 'Home' : 'Thuis') : en ? 'Away' : 'Uit'}
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="post">{en ? 'New fixtures coming soon.' : 'Binnenkort nieuwe matchen.'}</p>
        )
      }

      <p class="bron">
        {
          en
            ? 'Fixtures from the KAA Gent calendar. Kick-off times can still change.'
            : 'Overgenomen van de kalender van KAA Gent. Aanvangsuren kunnen nog wijzigen.'
        }
      </p>
    </div>
  </section>
</Base>

<style>
  .kop {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-m) var(--space-l);
  }

  @media (min-width: 56em) {
    .kop {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  .lead {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .punten {
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-soft);
  }

  .punten li {
    padding-block: var(--space-2xs);
    border-block-end: var(--border-hairline) solid var(--line);
  }

  .punten strong {
    display: block;
    color: var(--ink);
  }

  .voucher {
    margin-block-end: var(--space-l);
    padding: var(--space-m);
    background: var(--bg-raised);
    border: 2px solid var(--accent);
    border-radius: var(--radius-m);
  }

  .voucher__label {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .voucher__titel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin-block: var(--space-3xs) var(--space-2xs);
    font-size: var(--step-2);
  }

  .voucher__prijs {
    color: var(--accent-text);
  }

  .voucher__link {
    margin-block-start: var(--space-s);
  }


  .post {
    margin-block-start: var(--space-s);
    font-weight: 600;
  }

  /* ---- Uitstap naar het stadion ---- */
  .uitstap {
    display: grid;
    gap: var(--space-m);
    margin-block: var(--space-l);
    padding: var(--space-m);
    border: var(--border-hairline) solid var(--line-strong);
    background: var(--bg-raised);
  }

  .uitstap__affiche {
    width: 100%;
    max-width: 22rem;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .uitstap__titel {
    margin-block: var(--space-3xs) var(--space-2xs);
  }

  .uitstap__wanneer {
    font-weight: 700;
    color: var(--accent-text);
    margin-block-end: var(--space-xs);
  }

  @media (min-width: 48em) {
    .uitstap {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      align-items: center;
    }
  }

  /* ---- De matchen ---- */
  .matchen {
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 2px solid var(--ink);
  }

  .match {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: var(--border-hairline) solid var(--line);
  }

  .match__datum {
    color: var(--ink-soft);
  }

  .match__uur {
    color: var(--accent-text);
    font-weight: 700;
    text-align: end;
  }

  .match__uur--open {
    color: var(--ink-faint);
    font-weight: 400;
    font-size: var(--step--1);
  }

  .match__titel {
    font-weight: 700;
    color: var(--ink);
  }

  .match__plek {
    color: var(--ink-faint);
    font-size: var(--step--1);
    text-align: end;
  }

  @media (min-width: 56em) {
    .match {
      grid-template-columns: 16rem 9rem minmax(0, 1fr) 4rem;
      align-items: baseline;
    }

    .match__uur {
      text-align: start;
    }
  }

  .bron {
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
