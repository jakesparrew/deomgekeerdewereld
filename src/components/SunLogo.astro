---
/**
 * Het zonnetje met het gezicht — het merkteken van den Omgekeerde.
 * Bij hover draait hij een halve slag: de omgekeerde wereld in het klein.
 *
 * Vervang dit door het echte logobestand zodra je het als SVG hebt.
 * Zie de checklist in de README.
 */
interface Props {
  size?: number;
  class?: string;
  /** Draait bij hover. Zet uit voor decoratief gebruik in de voettekst. */
  spin?: boolean;
  title?: string;
}

const { size = 64, class: className = '', spin = true, title } = Astro.props;

const rays = Array.from({ length: 16 }, (_, i) => i * 22.5);
---

<svg
  class:list={['sun', spin && 'sun--spin', className]}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  fill="none"
>
  {title && <title>{title}</title>}

  <g class="sun__rays">
    {
      rays.map((angle, i) =>
        i % 2 === 0 ? (
          <path
            d="M50 2 L53.4 16 L46.6 16 Z"
            fill="currentColor"
            transform={`rotate(${angle} 50 50)`}
          />
        ) : (
          <path
            d="M50 7 C52.6 11, 52.6 13, 50 17 C47.4 13, 47.4 11, 50 7 Z"
            fill="currentColor"
            transform={`rotate(${angle} 50 50)`}
          />
        ),
      )
    }
  </g>

  <circle cx="50" cy="50" r="30" fill="currentColor" />

  <g class="sun__face" fill="var(--accent-ink, #0d0a07)">
    <!-- ogen -->
    <ellipse cx="41" cy="44" rx="3.1" ry="4.2" />
    <ellipse cx="59" cy="44" rx="3.1" ry="4.2" />
    <!-- wenkbrauwen -->
    <path
      d="M35.5 37.5 C38.5 34.8, 43 34.8, 46 37.2"
      stroke="var(--accent-ink, #0d0a07)"
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    />
    <path
      d="M54 37.2 C57 34.8, 61.5 34.8, 64.5 37.5"
      stroke="var(--accent-ink, #0d0a07)"
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    />
    <!-- neus -->
    <path
      d="M50 47 C48.4 52, 47.6 54.5, 50 55.6 C52.4 54.5, 51.6 52, 50 47 Z"
    />
    <!-- mond -->
    <path
      d="M40.5 60 C44 65.5, 56 65.5, 59.5 60 C55.5 62.6, 44.5 62.6, 40.5 60 Z"
    />
  </g>
</svg>

<style>
  .sun {
    color: var(--accent);
    flex: none;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .sun--spin:hover,
  a:hover > .sun--spin,
  a:focus-visible > .sun--spin {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .sun {
      transition: none;
    }
  }
</style>
