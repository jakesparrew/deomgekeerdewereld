---
/**
 * Het zonnetje met de maan: het echte logo, uit omgekeerde zon.ai.
 * Als masker, zodat het de kleur aanneemt van waar het staat.
 */
interface Props {
  size?: number;
  class?: string;
  spin?: boolean;
  title?: string;
}

const { size = 64, class: className = '', spin = true, title } = Astro.props;
---

<span
  class:list={['sun', spin && 'sun--spin', className]}
  style={`--sun-size:${size}px`}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}></span>

<style>
  .sun {
    display: inline-block;
    flex: none;
    width: var(--sun-size);
    aspect-ratio: 640 / 685;
    color: var(--amber);
    background: currentColor;
    -webkit-mask: url('/images/zon.png') no-repeat center / contain;
    mask: url('/images/zon.png') no-repeat center / contain;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .sun--spin:hover,
  :global(a:hover) > .sun--spin,
  :global(a:focus-visible) > .sun--spin {
    transform: rotate(180deg);
  }
</style>
