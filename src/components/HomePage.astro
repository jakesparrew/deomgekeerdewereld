---
/**
 * De homepagina, in beide talen. /  en  /en/  gebruiken allebei dit bestand.
 *
 * Opbouw zoals venues met een jong publiek het doen (Paradiso, Elsewhere,
 * Charlatan): de naam groot, één luide kleur, het programma meteen vooraan,
 * en foto's van nachten die echt zo waren.
 */
import Base from '../layouts/Base.astro';
import OpenStatus from './OpenStatus.astro';
import ReserveButton from './ReserveButton.astro';

import { site } from '../data/site';
import { highlights, events, menu } from '../lib/content';
import { buildAgenda } from '../lib/events';
import { euro, formatDayBadge, formatDate, formatTime, priceLabel } from '../lib/format';
import { route, strings, type Lang } from '../lib/i18n';
import { EVENT_TYPE_LABELS } from '../data/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = strings(lang);
const en = lang === 'en';

const agenda = buildAgenda(events, new Date());
const upcoming = agenda.upcoming.slice(0, 5);

const bvdm = highlights.beerOfTheMonth;
const tiles = highlights.tiles ?? [];
const opTap = menu.items.filter((i) => i.tags?.includes('op-tap') && i.price);

const title = en
  ? 'De Omgekeerde Wereld · student bar in Ghent'
  : 'De Omgekeerde Wereld · studentencafé in Gent';

const description = en
  ? 'Student bar opposite VIERNULVIER in Ghent. 69+ beers, lager €2,70, free pool, table football, free gigs and parties. Open every day from 2pm until late.'
  : 'Studentencafé rechtover VIERNULVIER in Gent. 69+ bierkes, pilske €2,70, gratis pool, kickeren, gratis concertjes en fiestjes. Elke dag open vanaf 14 uur.';

/** De lopende band: wat het kost, recht van het bord. */
const ticker = tiles.map((t) => ({
  label: en ? t.labelEn : t.label,
  value: en && t.valueEn ? t.valueEn : t.value,
}));

const weekday = (start: string) => formatDate(start, lang).split(' ')[0];
---

<Base title={title} description={description} lang={lang} rawTitle image="/images/gevel-nacht.jpg" events={upcoming}>
  <!-- ============================================================
       HERO — de gevel bij nacht, de naam over de volle breedte.
       Het tweede woord staat op zijn kop: dat is de naam.
       ============================================================ -->
  <section class="hero">
    <img
      class="hero__img"
      src="/images/gevel-nacht.jpg"
      alt={en
        ? 'The corner facade of De Omgekeerde Wereld at night, with the red Duvel sign above the door and a crowd outside.'
        : 'De hoekgevel van De Omgekeerde Wereld bij nacht, met het rode Duvel-bord boven de deur en volk op de stoep.'}
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="wrap wrap--wide hero__body">
      <p class="hero__kicker">
        <OpenStatus lang={lang} variant="pill" />
        <span>{en ? 'Student bar' : 'Studentencafé'} · Sint-Pietersnieuwstraat 116 · Gent</span>
      </p>

      <h1 class="hero__title">
        <span class="visually-hidden">De Omgekeerde Wereld</span>
        <span class="hero__line" aria-hidden="true">De Omgekeerde</span>
        <span class="hero__line hero__line--flip" aria-hidden="true">Wereld</span>
      </h1>

      <div class="hero__acties">
        <a class="btn btn--primary" href={route('agenda', lang)}>
          {en ? "What's on" : "Wa is't er te doen?"}
        </a>
        <a class="btn btn--ghost hero__ghost" href={route('menu', lang)}>
          {en ? 'The menu' : 'Toon keer de kaart'}
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       LOPENDE BAND — de prijzen van het bord
       ============================================================ -->
  <div class="band" role="region" aria-label={en ? 'Prices' : 'Prijzen'}>
    <ul class="visually-hidden">
      {ticker.map((t) => <li>{t.label}: {t.value}</li>)}
    </ul>
    <div class="band__track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <span class="band__set">
            {ticker.map((t) => (
              <span class="band__item">
                {t.label} <b>{t.value}</b>
                <span class="band__zon" />
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>

  <!-- ============================================================
       AGENDA — het programma, vooraan zoals bij elke goede venue
       ============================================================ -->
  <section class="sectie agenda">
    <div class="wrap wrap--wide">
      <header class="sectie__kop">
        <h2 class="sectie__titel">{en ? "What's on" : "Wa is't er te doen?"}</h2>
        <a class="sectie__link" href={route('agenda', lang)}>
          {en ? 'Full calendar' : 'Heel de agenda'} →
        </a>
      </header>

      {
        upcoming.length > 0 ? (
          <ol class="events" role="list">
            {upcoming.map((e) => {
              const d = formatDayBadge(e.start, lang);
              return (
                <li>
                  <a class="event" href={route('agenda', lang)}>
                    <span class="event__datum">
                      <span class="event__dag">{d.day}</span>
                      <span class="event__maand">{d.month}</span>
                    </span>
                    <span class="event__info">
                      <span class="event__type">
                        {EVENT_TYPE_LABELS[e.type]?.[lang] ?? e.type}
                      </span>
                      <span class="event__titel">{en && e.titleEn ? e.titleEn : e.title}</span>
                      <span class="event__meta">
                        {weekday(e.start)} · {formatTime(e.start)} · {priceLabel(e.price, lang)}
                      </span>
                    </span>
                    <span class="event__pijl" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="events__leeg">{T.noEvents}</p>
        )
      }
    </div>
  </section>

  <!-- ============================================================
       FIESTJES — de zaal zoals ze is
       ============================================================ -->
  <section class="fiest">
    <div class="wrap wrap--wide">
      <h2 class="fiest__titel">
        {en ? 'Gigs & parties' : 'Concertjes & fiestjes'}
        <span class="fiest__gratis">{en ? 'Free entry' : 'Gratis binnen'}</span>
      </h2>
    </div>
    <div class="fiest__fotos">
      <img
        src="/images/zaal-vol.jpg"
        alt={en
          ? 'A packed room under a disco ball, with an Aperol Spritz sign on the brick wall.'
          : 'Een volle zaal onder een discobol, met een Aperol Spritz-bord tegen de bakstenen muur.'}
        loading="lazy"
        decoding="async"
      />
      <img
        src="/images/dansvloer.jpg"
        alt={en
          ? 'People dancing with bottles in hand under pink and blue neon tubes.'
          : 'Mensen dansen met een flesje in de hand onder roze en blauwe neonbuizen.'}
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <!-- ============================================================
       BIERKES
       ============================================================ -->
  <section class="sectie bier">
    <div class="wrap wrap--wide bier__grid">
      <div class="bier__groot">
        <p class="bier__getal">69+</p>
        <h2 class="bier__titel">{en ? 'Beers' : 'Bierkes'}</h2>
        <p class="bier__lead">
          {
            en
              ? `From a ${euro(2.7)} lager to trappists, with fifteen alcohol-free ones in between.`
              : `Van een pilske van ${euro(2.7)} tot trappist, met vijftien keer 0,0 ertussen.`
          }
        </p>
        <a class="btn btn--primary" href={route('menu', lang)}>
          {en ? 'The whole menu' : 'Heel de kaart'}
        </a>
      </div>

      <div class="bier__lijsten">
        <div class="bvdm">
          <p class="bvdm__label">{T.beerOfTheMonth}</p>
          <p class="bvdm__naam">{bvdm.name}</p>
          <p class="bvdm__meta">
            {[bvdm.brewery, bvdm.style, bvdm.abv && `${String(bvdm.abv).replace('.', ',')}%`]
              .filter(Boolean)
              .join(' · ')}
          </p>
          {bvdm.price && <p class="bvdm__prijs">{euro(bvdm.price)}</p>}
        </div>

        {
          opTap.length > 0 && (
            <div class="tap">
              <p class="tap__label">{en ? 'On tap' : 'Van het vat'}</p>
              <ul class="tap__lijst" role="list">
                {opTap.map((b) => (
                  <li class="tap__rij">
                    <span>{b.name}</span>
                    <span class="tap__stip" aria-hidden="true" />
                    <span class="tap__prijs">{euro(b.price!)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       POOL
       ============================================================ -->
  <section class="pool">
    <img
      class="pool__img"
      src="/images/pool-zon.jpg"
      alt={en
        ? 'Friends around the red pool table under the lamps, with the sun of De Omgekeerde Wereld on the wall behind them.'
        : 'Vrienden rond de rode pooltafel onder de lampen, met het zonnetje van De Omgekeerde Wereld aan de muur.'}
      loading="lazy"
      decoding="async"
    />
    <div class="pool__shade" aria-hidden="true"></div>
    <div class="wrap wrap--wide pool__body">
      <h2 class="pool__titel">{en ? 'Free pool.' : 'Gratis pool.'}<br />{en ? 'Always.' : 'Altijd.'}</h2>
      <p class="pool__meta">
        {en ? `Table football ${euro(0.5)} · chess at the bar` : `Kickeren ${euro(0.5)} · schaakbord aan de toog`}
      </p>
    </div>
  </section>

  <!-- ============================================================
       BOVENZAAL
       ============================================================ -->
  <section class="boven">
    <div class="wrap wrap--wide boven__body">
      <h2 class="boven__titel">{en ? 'Rent the upstairs' : 'Huur de bovenzaal'}</h2>
      <div class="boven__rechts">
        <p class="boven__lead">
          {
            en
              ? 'Second floor, its own pool table and table football. For birthdays, club nights and small parties.'
              : 'Tweede verdiep, eigen pooltafel en kicker. Voor verjaardagen, clubavonden en kleine fuiven.'
          }
        </p>
        <div class="boven__knoppen">
          <ReserveButton lang={lang} kind="event" bare buttonClass="boven__btn" />
          <a class="boven__meer" href={route('upstairs', lang)}>{en ? 'About the upstairs' : 'Meer over de bovenzaal'} →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       INSTAGRAM
       ============================================================ -->
  <section class="sectie insta">
    <div class="wrap wrap--wide">
      <a class="insta__link" href={site.social.instagram} rel="me noopener">
        <span class="insta__label">{en ? 'Follow the night on' : 'Volg de nacht op'} Instagram</span>
        <span class="insta__handle">{site.social.instagramHandle}</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ============================================================ HERO */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(calc(100svh - 4.5rem), 62rem);
    min-height: max(34rem, min(calc(100svh - 4.5rem), 62rem));
    overflow: hidden;
    isolation: isolate;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(12 10 9 / 0.25) 0%, rgb(12 10 9 / 0) 30%),
      linear-gradient(0deg, rgb(12 10 9 / 0.96) 4%, rgb(12 10 9 / 0.55) 38%, rgb(12 10 9 / 0) 65%);
  }

  .hero__body {
    padding-block: var(--space-l) var(--space-l);
  }

  .hero__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #f6f0e6;
    margin-block-end: var(--space-s);
  }

  .hero__title {
    margin: 0;
    /* Begrensd door breedte én hoogte: drie regels mogen nooit hoger worden
       dan het scherm, anders vallen de knoppen eronder. */
    font-size: clamp(3.4rem, min(15.5vw, 17svh), 16rem);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.005em;
    color: #f6f0e6;
  }

  .hero__line {
    display: block;
  }

  /* De omgekeerde wereld, letterlijk. */
  .hero__line--flip {
    display: inline-block;
    color: var(--accent);
    transform: rotate(180deg);
    padding-block-start: 0.04em;
  }

  .hero__acties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }

  .hero__ghost {
    color: #f6f0e6;
    border-color: rgb(246 240 230 / 0.6);
  }

  .hero__ghost:hover {
    background: #f6f0e6;
    border-color: #f6f0e6;
    color: #0c0a09;
  }

  /* ============================================================ BAND */
  .band {
    overflow: hidden;
    background: var(--accent);
    color: var(--accent-ink);
    border-block: 2px solid var(--bg);
  }

  .band__track {
    display: flex;
    width: max-content;
    animation: band 38s linear infinite;
  }

  .band__set {
    display: flex;
  }

  .band__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding-block: 0.55em;
    padding-inline-start: 0.9em;
    font-size: var(--step-1);
    font-stretch: 72%;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .band__item b {
    font-weight: 900;
  }

  .band__zon {
    width: 0.55em;
    height: 0.55em;
    margin-inline-start: 0.45em;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 2px var(--accent-ink);
  }

  @keyframes band {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band__track {
      animation: none;
    }
  }

  /* ============================================================ SECTIES */
  .sectie {
    padding-block: var(--space-2xl);
  }

  .sectie__kop {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  .sectie__titel {
    font-size: var(--step-5);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    margin: 0;
  }

  .sectie__link {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    border-block-end: 2px solid var(--accent);
    padding-block-end: 2px;
  }

  .sectie__link:hover {
    color: var(--accent-text);
  }

  /* ============================================================ AGENDA */
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 2px solid var(--ink);
  }

  .event {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-s) var(--space-2xs);
    color: var(--ink);
    text-decoration: none;
    border-block-end: 1px solid var(--line-strong);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .event:hover,
  .event:focus-visible {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .event__datum {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.2rem;
    line-height: 0.85;
    font-stretch: var(--stretch-poster);
    text-transform: uppercase;
  }

  .event__dag {
    font-size: var(--step-4);
    font-weight: 900;
    color: var(--accent-text);
  }

  .event__maand {
    font-size: var(--step-0);
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
  }

  .event:hover .event__dag,
  .event:focus-visible .event__dag {
    color: var(--accent-ink);
  }

  .event__info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .event__type {
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    opacity: 0.75;
  }

  .event__titel {
    font-size: var(--step-3);
    font-stretch: var(--stretch-head);
    font-weight: 850;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .event__meta {
    font-size: var(--step--1);
    opacity: 0.8;
  }

  .event__pijl {
    font-size: var(--step-3);
    font-weight: 700;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .event:hover .event__pijl {
    transform: translateX(6px);
  }

  .events__leeg {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 40ch;
  }

  @media (max-width: 40em) {
    .event {
      gap: var(--space-s);
    }

    .event__pijl {
      display: none;
    }
  }

  /* ============================================================ FIESTJES */
  .fiest {
    padding-block: var(--space-xl) 0;
  }

  .fiest__titel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-m);
    font-size: var(--step-6);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    margin: 0 0 var(--space-m);
  }

  .fiest__gratis {
    font-size: var(--step-1);
    font-stretch: 85%;
    font-weight: 800;
    letter-spacing: var(--tracking-wide);
    padding: 0.35em 0.8em;
    background: var(--amber);
    color: var(--amber-ink);
    border-radius: var(--radius-pill);
    transform: rotate(-3deg);
  }

  .fiest__fotos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .fiest__fotos img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* ============================================================ BIER */
  .bier__grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 60em) {
    .bier__grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
    }
  }

  .bier__getal {
    font-size: clamp(7rem, 26vw, 22rem);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    line-height: 0.78;
    color: var(--amber);
    margin: 0;
  }

  .bier__titel {
    font-size: var(--step-5);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    margin: 0 0 var(--space-s);
  }

  .bier__lead {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
    max-width: 30ch;
    margin-block-end: var(--space-m);
  }

  .bier__lijsten {
    display: grid;
    gap: var(--space-m);
  }

  .bvdm {
    padding: var(--space-m);
    border: 2px solid var(--amber);
    border-radius: var(--radius-m);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem var(--space-s);
  }

  .bvdm__label,
  .tap__label {
    grid-column: 1 / -1;
    font-size: var(--step--2);
    font-weight: 800;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--amber);
    margin: 0;
  }

  .bvdm__naam {
    font-size: var(--step-3);
    font-stretch: var(--stretch-head);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
    margin: 0;
  }

  .bvdm__prijs {
    grid-row: 2 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: var(--step-3);
    font-stretch: var(--stretch-head);
    font-weight: 900;
    color: var(--amber);
    margin: 0;
  }

  .bvdm__meta {
    font-size: var(--step--1);
    color: var(--ink-faint);
    margin: 0;
  }

  .tap__lijst {
    margin: var(--space-2xs) 0 0;
    padding: 0;
    list-style: none;
  }

  .tap__rij {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .tap__stip {
    flex: 1;
    border-block-end: 2px dotted var(--line-strong);
    transform: translateY(-0.25em);
  }

  .tap__prijs {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--amber);
  }

  /* ============================================================ POOL */
  .pool {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(28rem, 75vw, 56rem);
    overflow: hidden;
    isolation: isolate;
  }

  .pool__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .pool__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(12 10 9 / 0.92) 0%, rgb(12 10 9 / 0.35) 35%, rgb(12 10 9 / 0) 60%);
  }

  .pool__body {
    padding-block: var(--space-xl);
  }

  .pool__titel {
    font-size: var(--step-6);
    font-stretch: var(--stretch-poster);
    font-weight: 900;
    color: #f6f0e6;
    margin: 0 0 var(--space-xs);
  }

  .pool__meta {
    font-size: var(--step-1);
    font-weight: 600;
    color: #f6f0e6;
  }

  /* ============================================================ BOVENZAAL */
  .boven {
    background: var(--amber);
    color: var(--amber-ink);
    padding-block: var(--space-2xl);
  }

  .boven__body {
    display: grid;
    gap: var(--space-m);
    align-items: end;
  }

  @media (min-width: 60em) {
    .boven__body {
      grid-template-columns: 1.4fr 1fr;
