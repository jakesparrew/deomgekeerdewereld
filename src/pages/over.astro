---
/**
 * Ons verhaal — hoe drie gasten een leegstaand pand rechtover de Vooruit
 * in den Omgekeerde veranderd hebben.
 */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import SunLogo from '../components/SunLogo.astro';

import { site } from '../data/site';
import { hours } from '../lib/content';
import { getWeekRows } from '../lib/hours';
import { euro } from '../lib/format';
import { route, strings, type Lang } from '../lib/i18n';

const lang: Lang = 'nl';
const T = strings(lang);

/* ---- Uren samengevat: dagen met dezelfde uren gaan samen op één lijn ---- */
interface HourGroup {
  from: string;
  to: string;
  closed: boolean;
  open?: string;
  close?: string;
}

const groups: HourGroup[] = [];
for (const row of getWeekRows(hours, new Date(), lang)) {
  const last = groups[groups.length - 1];
  if (last && last.closed === row.closed && last.open === row.open && last.close === row.close) {
    last.to = row.label;
  } else {
    groups.push({
      from: row.label,
      to: row.label,
      closed: row.closed,
      open: row.open,
      close: row.close,
    });
  }
}

const groupLabel = (g: HourGroup) =>
  g.from === g.to ? g.from : `${g.from} tot ${g.to.toLowerCase()}`;

const groupValue = (g: HourGroup) =>
  g.closed ? T.closed : `${g.open} – ${g.close}`;

const facts = [
  { value: String(site.founded), label: 'toen we de sleutel kregen' },
  { value: '69+', label: 'bierkes op de kaart' },
  { value: euro(2.7), label: 'voor een pilske' },
  { value: '7/7', label: 'open van 14 uur tot laat' },
];

const pairs: [string, string][] = [
  ['Jong', 'oud'],
  ['Dag', 'nacht'],
  ['Oude school', 'van vandaag'],
  ['Klant', 'barman'],
  ['Student', 'buurman'],
];

const doings = [
  {
    icon: 'pool',
    title: 'Poolke leggen',
    price: 'Gratis',
    text: 'Altijd gratis, geen muntstukken nodig. Ge moet enkel wachten tot de tafel vrij is.',
  },
  {
    icon: 'foosball',
    title: 'Kickeren',
    price: euro(0.5),
    text: 'Een halve euro de match. Breng kleingeld mee, of vraag het aan de toog.',
  },
  {
    icon: 'chess',
    title: 'Een partijke schaak',
    price: 'Gratis',
    text: 'Het bord ligt achter de toog. Vraag er gerust naar, ook als ge alleen zit.',
  },
  {
    icon: 'music',
    title: 'Concerten en fuiven',
    price: 'Gratis binnen',
    text: 'Optredens en feestjes, altijd gratis. Wat en wanneer staat op Instagram.',
  },
];

const description =
  'Het verhaal van den Omgekeerde: sinds 2014 een bruine kroeg in Gent, rechtover VIERNULVIER. 69+ bierkes, gratis poolke en muziek voor studenten én buren.';
---

<Base
  title="Ons verhaal"
  description={description}
  lang={lang}
  active="about"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Ons verhaal', url: '/over/' },
  ]}
>
  <!-- ============================================================
       Intro
       ============================================================ -->
  <section class="section hero">
    <div class="wrap">
      <div class="hero__grid">
        <div>
          <p class="eyebrow">Ons verhaal</p>
          <h1>Drie gasten, een leeg pand, rechtover de Vooruit</h1>
          <p class="hero__lead">
            Het begon in 2014 met een sleutel, een leegstaand pand en veel te veel goesting.
            Meer plan was er niet.
          </p>
        </div>

        <div class="hero__media">
          <Photo src="/images/gevel-familie.jpg"
            alt="De gevel van De Omgekeerde Wereld met een ballonnenboog, het gouden zonnetje boven de deur en drie mensen in de deuropening."
            brief=""
            ratio="4 / 3"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <ul class="facts">
        {
          facts.map((fact) => (
            <li class="fact">
              <p class="fact__value">{fact.value}</p>
              <p class="fact__label">{fact.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================================
       Hoe het begon
       ============================================================ -->
  <section class="section band">
    <div class="wrap">
      <p class="eyebrow">Hoe't begon</p>
      <h2>Een plek zoals vroeger</h2>

      <div class="split">
        <div class="prose split__text">
          <p>
            Drie ondernemende gasten huren een leegstaand pand, rechtover de Vooruit in de
            Sint-Pietersnieuwstraat te Gent. De naam ontstaat uit onze doelstellingen: een
            plek creëren waar zowel jong als oud zich thuis voelt. Een plek zoals vroeger,
            waar klant en barman één zijn. Een plek met betaalbare prijzen voor iedereen.
            Een plek met fantastische muziek, vaak uit den ouwen doos. Een plek die even de
            buitenwereld vergeet.
          </p>
          <p>
            De Vooruit heet ondertussen VIERNULVIER. Wij staan er nog altijd, elke dag
            vanaf twee uur.
          </p>
        </div>

        <div class="split__media">
          <Photo src="/images/toog-lachen.jpg"
            alt="Twee vriendinnen lachen met een glas in de hand aan de toog."
            brief=""
            ratio="3 / 2"
            caption="De toog, ergens tussen de eerste en de tweede toer."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       De naam
       ============================================================ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">De naam</p>
      <h2>Waarom 'De Omgekeerde Wereld'?</h2>

      <div class="split split--reverse">
        <div class="name__text">
          <div class="prose">
            <p>
              Dingen die volgens de rest van de wereld niet naast elkaar horen, zitten
              hier aan dezelfde tafel.
            </p>
          </div>

          <ul class="flips">
            {
              pairs.map(([a, b]) => (
                <li>
                  <span class="flip__a">{a}</span>
                  <span class="flip__x" aria-hidden="true">&#8644;</span>
                  <span class="visually-hidden"> en </span>
                  <span class="flip__b">{b}</span>
                </li>
              ))
            }
          </ul>

          <p class="name__wink">
            <span class="name__sun"><SunLogo size={40} /></span>
            <span>
              Vindt ge ergens op deze site een knop die de hele wereld op zijn kop zet? Da's
              geen fout. Doet maar, hij draait ook terug.
            </span>
          </p>
        </div>

        <div class="split__media">
          <Photo src="/images/lange-tafel.jpg"
            alt="Een lange tafel vol volk dat lacht en klinkt, met glazen en flesjes voor hen."
            brief=""
            ratio="3 / 2"
            caption="Dezelfde zaal, acht uur later op de dag."
          />
        </div>
      </div>
    </div>
  </section>

  

  <!-- ============================================================
       De familie
       ============================================================ -->
  <section class="section familie">
    <div class="wrap wrap--wide familie__grid">
      <div class="familie__text prose stack">
        <p class="eyebrow">De familie</p>
        <h2>Hier zijde geen klant</h2>

        <p class="lead">
          Van voetbalploegen tot quizteams, van studentenclubs tot het personeel en
          de vaste gezichten: den Omgekeerde draait op zijn volk.
        </p>

        <p>
          Daarom keren we een paar regels van de horeca om. Poolen is gratis. Ge
          moogt een broodje van buiten meebrengen. De koffie komt uit de kan.
          Concerten en fuiven vragen geen inkom.
        </p>

        <p>
          En komt er iemand met een idee af, dan supporteren we dat. Van vroeg tot
          laat.
        </p>
      </div>

      <div class="familie__fotos">
        <Photo
          src="/images/familie-toost.jpg"
          alt="Een groep vrienden klinkt met de armen om elkaar heen aan een tonnetje in De Omgekeerde Wereld."
          brief=""
          ratio="4 / 5"
        />
        <Photo
          src="/images/broodjes.jpg"
          alt="Vier mensen eten meegebracht eten aan een tafel in het café, onder de glazenrekken."
          brief=""
          ratio="3 / 2"
          caption="Eten van buiten? Geen probleem. Dat is hier altijd zo geweest."
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
       Wat er te doen is
       ============================================================ -->
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Bezigheden</p>
      <h2>Wa kunde hier zoal doen?</h2>

      <div class="prose">
        <p>
          Behalve bierkes drinken en luisteren, bedoelen we. Ge moet niks bestellen om mee te
          doen, en ge moet ook niet goed zijn.
        </p>
      </div>

      <ul class="does">
        {
          doings.map((item) => (
            <li class="card">
              <span class="does__icon">
                <Icon name={item.icon} size={28} />
              </span>
              <h3>{item.title}</h3>
              <p class="does__price">{item.price}</p>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>

      <p class="note">
        Studenten met de Guido Gids krijgen bij ons 1+1. En wat er deze week te doen is, zet
        Tristan op
        <a href={site.social.instagram} rel="noopener" target="_blank">
          Instagram {site.social.instagramHandle}
          <span class="visually-hidden">(opent in een nieuw venster)</span>
        </a>.
      </p>

      <div class="does__media">
        <Photo src="/images/poolke.jpg"
          alt="Iemand stoot af op de pooltafel met rood laken, een tweede speler kijkt toe."
          brief=""
          ratio="3 / 2"
          caption="De pooltafel is gratis. Wel zelf de ballen terugleggen."
        />
      </div>
    </div>
  </section>

  

  <!-- ============================================================
       Afsluiter: uren + wegwijzers
       ============================================================ -->
  <section class="section closing">
    <div class="wrap">
      <div class="closing__grid">
        <div>
          <p class="eyebrow">{T.whenOpen}</p>
          <h2>Elke dag. Echt elke dag.</h2>
          <p class="closing__lead">
            {T.openEveryDay}. Donderdag, vrijdag en zaterdag blijven we langer plakken.
          </p>
          <p class="closing__status"><OpenStatus lang={lang} variant="pill" /></p>
        </div>

        <div>
          <dl class="hours">
            {
              groups.map((g) => (
                <div class="hours__row">
                  <dt>{groupLabel(g)}</dt>
                  <dd>{groupValue(g)}</dd>
                </div>
              ))
            }
          </dl>

          {hours.note && <p class="note note--tight">{hours.note}</p>}

          <div class="actions">
            <a class="btn btn--primary" href={route('menu', lang)}>Toon keer de kaart</a>
            <a class="btn btn--ghost" href={route('agenda', lang)}>Wa is't er te doen?</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Intro ---- */
  .hero {
    padding-block-end: var(--space-xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
  }

  .hero h1 {
    margin-block-start: var(--space-xs);
  }

  .hero__lead {
    margin-block-start: var(--space-m);
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: center;
      gap: var(--space-xl);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    padding-inline-start: 0;
    list-style: none;
    border-block-start: var(--border-hairline) solid var(--line);
  }

  @media (min-width: 44em) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .fact__value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--accent-text);
  }

  .fact__label {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--ink-soft);
  }

  /* ---- Afwisselende band, zodat de secties uit elkaar vallen ---- */
  .band {
    background: var(--bg-raised);
    border-block: var(--border-hairline) solid var(--line);
  }

  /* ---- Tekst naast beeld ---- */
  .split {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-l);
  }

  @media (min-width: 56em) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      align-items: start;
    }

    .split--reverse .split__media {
      order: -1;
    }
  }

  /* ---- De naam ---- */
  .flips {
    display: grid;
    gap: 0;
    margin-block-start: var(--space-l);
    padding-inline-start: 0;
    list-style: none;
  }

  .flips li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    padding-block: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    border-block-end: var(--border-hairline) solid var(--line);
  }

  .flip__x {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 400;
    color: var(--ink-faint);
  }

  .flip__b {
    color: var(--accent-text);
  }

  .name__wink {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
    padding: var(--space-s);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
    background: var(--bg-inset);
    border: var(--border-hairline) solid var(--line);
    border-radius: var(--radius-m);
  }

  .name__sun {
    display: flex;
    flex: none;
    color: var(--amber);
  }

  /* ---- Muziek ---- */
  .sets {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
    padding-inline-start: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .sets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }

  .set {
    padding-inline-start: var(--space-s);
    border-inline-start: 2px solid var(--line-strong);
  }

  .set h3 {
    font-size: var(--step-1);
  }

  .set p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* ---- Bezigheden ---- */
  .does {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
    padding-inline-start: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .does {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .does {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .does .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    height: 100%;
  }

  .does__icon {
    display: flex;
    margin-block-end: var(--space-2xs);
    color: var(--accent-text);
  }

  .does h3 {
    font-size: var(--step-1);
  }

  /* --amber haalt op de lichte kaartachtergrond geen 4.5:1 voor kleine tekst,
     --accent-text wel. Daarom staat de prijs in de accentkleur. */
  .does__price {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .does .card p:last-child {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .does__media {
    margin-block-start: var(--space-l);
  }

  /* ---- Losse noot onder een blok ---- */
  .note {
    max-width: var(--measure);
    margin-block-start: var(--space-l);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .note--tight {
    margin-block-start: var(--space-s);
  }

  /* ---- Pers ---- */
  .quotes {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-l);
  }

  @media (min-width: 52em) {
    .quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }
  }

  .quote {
    margin: 0;
    padding: var(--space-m);
    background: var(--bg);
    border: var(--border-hairline) solid var(--line);
    border-inline-start: 3px solid var(--amber);
    border-radius: var(--radius-m);
  }

  .quote__body p {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  .quote__by {
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .quote__gloss {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  /* ---- Afsluiter ---- */
  .closing__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 52em) {
    .closing__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .closing h2 {
    margin-block-start: var(--space-xs);
  }

  .closing__lead {
    max-width: 34ch;
    margin-block-start: var(--space-s);
    color: var(--ink-soft);
  }

  .closing__status {
    margin-block-start: var(--space-m);
  }

  .hours {
    margin: 0;
  }

  .hours__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-block-end: var(--border-hairline) solid var(--line);
  }

  .hours dt {
    color: var(--ink-soft);
  }

  .hours dd {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }

  /* ---- De familie ---- */
  .familie {
    background: var(--bg-raised);
    border-block: var(--border-hairline) solid var(--line);
  }

  .familie__grid {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 56em) {
    .familie__grid {
      grid-template-columns: 1.25fr 1fr;
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .familie__fotos {
    display: grid;
    gap: var(--space-s);
  }

</style>
