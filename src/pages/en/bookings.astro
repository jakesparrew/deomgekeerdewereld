---
/**
 * Bookings — English twin of /reserveren/.
 * Den Omgekeerde is a walk-in bar. This page is short on purpose: reserve a
 * table, or ask about a group, a party, a concert or a collaboration.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import ReserveButton from '../../components/ReserveButton.astro';

import { site } from '../../data/site';
import { route, strings } from '../../lib/i18n';

const lang = 'en' as const;
const T = strings(lang);

const breadcrumbs = [
  { name: 'Home', url: route('home', lang) },
  { name: 'Bookings', url: route('reserve', lang) },
];
---

<Base
  title="Bookings"
  description="You never need to book a table at De Omgekeerde Wereld for a beer. Coming with a group, celebrating something, or got an idea for a concert or a collaboration? Tell us here."
  lang={lang}
  active="reserve"
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Bookings</p>
      <h1>{T.reserveTitle}</h1>

      <p class="lead">
        You do not need to book anything for a beer: just walk in, every day from
        1:30pm until 3am. If you would rather be sure of a table, reserve one.
      </p>
      <p class="reserve-cta">
        <ReserveButton lang={lang} variant="primary" />
      </p>
    </div>
  </section>

  <section class="section section--tight" id="request">
    <div class="wrap">
      <h2>A group, a party or an idea?</h2>
      <p class="aanvraag__intro">
        A birthday, a leaving do, a concert or a collaboration: request it
        directly. It lands straight with the right person.
      </p>
      <p class="reserve-cta">
        <ReserveButton lang={lang} kind="event" />
      </p>

      <div class="aanvraag">
        <aside class="aanvraag__aside" aria-labelledby="direct-title">
          <Photo
            src="/images/groep-klinken.jpg"
            alt="Seven friends around a round wooden table at De Omgekeerde Wereld raising Trappist glasses in a toast, with a lit red candle in the middle."
            brief=""
            ratio="4 / 3"
          />

          <div class="card direct">
            <h3 class="direct__title" id="direct-title">Rather call or email?</h3>
            <p>
              <a class="direct__big" href={`tel:${site.phoneHref}`}>
                <Icon name="phone" size={18} />
                {site.phone}
              </a>
            </p>
            <ul class="direct__mails" role="list">
              <li>
                <a href={`mailto:${site.email.events}`}>{site.email.events}</a>
                <span class="direct__who">Tristan — events, groups and bookings</span>
              </li>
              <li>
                <a href={`mailto:${site.email.partnerships}`}>{site.email.partnerships}</a>
                <span class="direct__who">Ran — collaborations</span>
              </li>
              <li>
                <a href={`mailto:${site.email.general}`}>{site.email.general}</a>
                <span class="direct__who">Everything else</span>
              </li>
            </ul>
            <p class="direct__note">We usually answer within two days. In a hurry? Just call.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    max-width: var(--measure);
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .reserve-cta {
    margin-block-start: var(--space-m);
  }

  /* ---- The form ---- */
  .aanvraag__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-2xs);
    color: var(--ink-soft);
  }

  .aanvraag {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-m);
  }

  @media (min-width: 60em) {
    .aanvraag__aside {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .aanvraag__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* ---- Call or email ---- */
  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .direct__title {
    font-size: var(--step-1);
  }

  .direct__big {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .direct__mails {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .direct__mails li {
    display: flex;
    flex-direction: column;
  }

  .direct__mails a {
    font-weight: 600;
    word-break: break-word;
  }

  .direct__who {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .direct__note {
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }
</style>
