---
/**
 * Reserveren — of beter: aanvragen.
 * Den Omgekeerde is een inloopcafé. Deze pagina is kort met opzet:
 * een tafel vastleggen, of iets aanvragen voor een groep, een feestje,
 * een concert of een samenwerking.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ReserveButton from '../components/ReserveButton.astro';

import { site } from '../data/site';
import { route, strings } from '../lib/i18n';

const lang = 'nl' as const;
const T = strings(lang);

const breadcrumbs = [
  { name: 'Home', url: route('home', lang) },
  { name: 'Reserveren', url: route('reserve', lang) },
];
---

<Base
  title="Reserveren"
  description="Voor een pintje moet ge bij den Omgekeerde niks reserveren. Komt ge met een groep, viert ge iets, of hebt ge een voorstel voor een concert of een samenwerking? Laat het hier weten."
  lang={lang}
  active="reserve"
  breadcrumbs={breadcrumbs}
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Reserveren</p>
      <h1>{T.reserveTitle}</h1>

      <p class="lead">
        Voor een pintje moet ge niks reserveren: kom gewoon binnen, elke dag van
        13u30 tot 3 uur. Wilt ge zeker zijn van een tafel, leg er dan een vast.
      </p>
      <p class="reserve-cta">
        <ReserveButton lang={lang} variant="primary" />
      </p>
    </div>
  </section>

  <section class="section section--tight" id="aanvraag">
    <div class="wrap">
      <h2>Een groep, een feestje of een voorstel?</h2>
      <p class="aanvraag__intro">
        Een verjaardag, een afscheid, een concert of een samenwerking: vraag het
        rechtstreeks aan. Het komt meteen bij de juiste persoon terecht.
      </p>
      <p class="reserve-cta">
        <ReserveButton lang={lang} kind="event" />
      </p>

      <div class="aanvraag">
        <aside class="aanvraag__aside" aria-labelledby="direct-titel">
          <Photo
            src="/images/groep-klinken.jpg"
            alt="Zeven vrienden rond een rond houten tafeltje in De Omgekeerde Wereld klinken met trappistenglazen, met een brandende rode kaars in het midden."
            brief=""
            ratio="4 / 3"
          />

          <div class="card direct">
            <h3 class="direct__title" id="direct-titel">Liever bellen of mailen?</h3>
            <p>
              <a class="direct__big" href={`tel:${site.phoneHref}`}>
                <Icon name="phone" size={18} />
                {site.phone}
              </a>
            </p>
            <ul class="direct__mails" role="list">
              <li>
                <a href={`mailto:${site.email.events}`}>{site.email.events}</a>
                <span class="direct__who">Tristan — events, groepen en boekingen</span>
              </li>
              <li>
                <a href={`mailto:${site.email.partnerships}`}>{site.email.partnerships}</a>
                <span class="direct__who">Ran — samenwerkingen</span>
              </li>
              <li>
                <a href={`mailto:${site.email.general}`}>{site.email.general}</a>
                <span class="direct__who">Al de rest</span>
              </li>
            </ul>
            <p class="direct__note">Meestal antwoorden we binnen twee dagen. Dringend? Bel gewoon.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    max-width: var(--measure);
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .reserve-cta {
    margin-block-start: var(--space-m);
  }

  /* ---- Het formulier ---- */
  .aanvraag__intro {
    max-width: var(--measure);
    margin-block-start: var(--space-2xs);
    color: var(--ink-soft);
  }

  .aanvraag {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-m);
  }

  @media (min-width: 60em) {
    /* Het formulier is weg (het gaf een 405 op Vercel); foto en bel/mail-kaart
       staan nu naast elkaar. */
    .aanvraag__aside {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .aanvraag__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  /* ---- Bellen of mailen ---- */
  .direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .direct__title {
    font-size: var(--step-1);
  }

  .direct__big {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .direct__mails {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .direct__mails li {
    display: flex;
    flex-direction: column;
  }

  .direct__mails a {
    font-weight: 600;
    word-break: break-word;
  }

  .direct__who {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .direct__note {
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }
</style>
